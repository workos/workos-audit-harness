{
  "name": "@workos-inc/audit-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "WorkOS audit log harness CLI plus shared MCP server, config loader, and CLI helpers for the WorkOS audit plugins.",
  "main": "./index.mjs",
  "bin": {
    "workos-audit-harness": "./bin/workos-audit-harness.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./config": "./src/config.mjs",
    "./mcp-server": "./src/mcp-server.mjs",
    "./schema-cli": "./src/schema-cli.mjs",
    "./hook-runtime": "./src/hook-runtime.mjs",
    "./print-config-status": "./src/print-config-status.mjs",
    "./util": "./src/util.mjs",
    "./device-cert": "./src/device-cert.mjs",
    "./harness-path": "./src/harness-path.mjs",
    "./audit-query": "./src/audit-query.mjs",
    "./emit-event": "./src/cli/emit-event.mjs",
    "./event-batcher": "./src/event-batcher.mjs",
    "./schema": "./src/cli/schema.mjs",
    "./harness-schemas": "./src/harness-audit-schemas.mjs",
    "./workos-client": "./src/workos-client.mjs"
  },
  "files": [
    "index.mjs",
    "src/**",
    "bin/workos-audit-harness.mjs",
    "scripts/audit-log-harness.mjs",
    "scripts/postinstall.mjs"
  ],
  "scripts": {
    "audit-harness": "node bin/workos-audit-harness.mjs",
    "workos-auth-login": "node bin/workos-audit-harness.mjs auth-login",
    "create:harness-schemas": "node bin/workos-audit-harness.mjs seed-generic-schemas",
    "build:cli": "node scripts/build-cli.mjs",
    "test": "node --test test/*.test.mjs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "@workos-inc/node": "^10.13.0",
    "typebox": "^1.1.38",
    "zod": "^4.4.3"
  }
}
