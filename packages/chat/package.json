{
  "name": "workos-audit-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run db:migrate:local",
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "npm run build && wrangler dev",
    "db:create": "wrangler d1 create workos-audit-chat-db",
    "deploy": "npm run build && wrangler deploy",
    "logs": "wrangler tail",
    "deployments": "wrangler deployments list",
    "cf-typegen": "wrangler types",
    "postinstall": "npm run cf-typegen",
    "lint": "oxlint app/ workers/ --ignore-pattern app/vendor/design-system",
    "format": "oxfmt --write app package.json postcss.config.mjs scripts/sync-design-system.mjs tsconfig.cloudflare.json '!app/vendor/design-system/**'",
    "format:check": "oxfmt --check app package.json postcss.config.mjs scripts/sync-design-system.mjs tsconfig.cloudflare.json '!app/vendor/design-system/**'",
    "db:migrate:local": "CI=1 wrangler d1 migrations apply workos-audit-chat-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply workos-audit-chat-db --remote",
    "sync-design-system": "node scripts/sync-design-system.mjs",
    "verify": "npx tsc --noEmit && npm run build",
    "wrangler": "wrangler"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.83",
    "@ai-sdk/openai": "^3.0.70",
    "@ai-sdk/react": "^3.0.204",
    "@ariakit/react": "^0.4.17",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/language": "^6.10.4",
    "@codemirror/lint": "^6.8.3",
    "@codemirror/state": "^6.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@hookform/resolvers": "^3.1.0",
    "@lezer/highlight": "^1.2.1",
    "@radix-ui/react-icons": "^2.0.0-rc.1776195498999",
    "@radix-ui/themes": "^3.3.0",
    "@uiw/react-codemirror": "^4.23.6",
    "@workos-inc/authkit-react-router": "^0.11.0",
    "ai": "^6.0.79",
    "ai-gateway-provider": "^3.1.1",
    "aria-hidden": "^1.2.6",
    "classnames": "^2.3.1",
    "date-fns": "^4.1.0",
    "isbot": "^5.1.31",
    "match-sorter": "^8.0.1",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "react-remove-scroll": "^2.6.3",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "scroll-into-view-if-needed": "^2.2.26",
    "tslib": "^2.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.5",
    "@cloudflare/workers-types": "^5",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.48.0",
    "postcss": "^8.5.6",
    "postcss-custom-media": "^12.0.1",
    "postcss-hover-media-feature": "^1.0.2",
    "postcss-import": "^16.1.1",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vite": "^7",
    "vite-tsconfig-paths": "^6",
    "wrangler": "^4"
  },
  "overrides": {
    "@workos-inc/authkit-react-router": {
      "react-router": "$react-router"
    },
    "undici": "^7.29.0"
  }
}
