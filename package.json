{
  "name": "workos-audit-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "WorkOS audit logging for Claude Code, Codex, OpenClaw, OpenCode, Hermes Agent, and the pi-coding-agent.",
  "workspaces": [
    "packages/audit-core",
    "packages/claude-plugin",
    "packages/codex-plugin",
    "packages/hermes-plugin",
    "packages/openclaw-plugin",
    "packages/opencode-plugin",
    "packages/pi-extension",
    "packages/proxy",
    "packages/site",
    "packages/installer"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-extension/dist/index.mjs"
    ]
  },
  "scripts": {
    "audit-harness": "npm run audit-harness -w @workos-inc/audit-core",
    "check:versions": "node scripts/check-plugin-versions.mjs",
    "workos-auth-login": "npm run workos-auth-login -w @workos-inc/audit-core",
    "proxy:dev": "npm run dev -w @workos-inc/audit-proxy",
    "proxy:deploy": "npm run deploy -w @workos-inc/audit-proxy",
    "create:harness-schemas": "npm run create:harness-schemas -w @workos-inc/audit-core",
    "create:claude-schemas": "npm run create:schemas -w @workos-inc/claude-audit-plugin",
    "remove:claude-schemas": "npm run remove:schemas -w @workos-inc/claude-audit-plugin",
    "create:codex-schemas": "npm run create:schemas -w @workos-inc/codex-audit-plugin",
    "remove:codex-schemas": "npm run remove:schemas -w @workos-inc/codex-audit-plugin",
    "create:openclaw-schemas": "npm run create:schemas -w @workos-inc/openclaw-audit-plugin",
    "remove:openclaw-schemas": "npm run remove:schemas -w @workos-inc/openclaw-audit-plugin",
    "create:opencode-schemas": "npm run create:schemas -w @workos-inc/opencode-audit-plugin",
    "remove:opencode-schemas": "npm run remove:schemas -w @workos-inc/opencode-audit-plugin",
    "create:hermes-schemas": "npm run create:schemas -w @workos-inc/hermes-audit-plugin",
    "remove:hermes-schemas": "npm run remove:schemas -w @workos-inc/hermes-audit-plugin",
    "quick-install": "node packages/installer/bin.mjs"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.0"
    },
    "next": {
      "postcss": "^8.5.23",
      "sharp": "^0.35.0"
    }
  },
  "bin": {
    "workos-audit-install": "packages/installer/bin.mjs"
  }
}
